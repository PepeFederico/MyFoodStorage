<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="800.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myfoodstorage.pepefederico.progettoispw_2024.controller.grafico.VisualizzaStatoOrdineController">

  <VBox prefHeight="800.0" prefWidth="800.0" styleClass="menu_container" stylesheets="@../../../../../style/dashboard.css">
    <ScrollPane fx:id="scrollPane" prefHeight="740.0" prefWidth="800.0" style="-fx-background-color: #FFFFFF;">
      <GridPane fx:id="gridPane">
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
      </GridPane>
    </ScrollPane>
      <HBox alignment="CENTER">
          <Button fx:id="backToRicercaProdotti" alignment="CENTER" mnemonicParsing="false" styleClass="menu_container" stylesheets="@../../../../../style/dashboard.css" text="Indietro">
             <graphic>
                <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                  <Image url="@../../../../../image/back.png" />
                </ImageView>
             </graphic>
               <HBox.margin>
                  <Insets right="15.0" />
               </HBox.margin>
          </Button>
            <Button fx:id="aggiornaStatoOrdini" mnemonicParsing="false" styleClass="menu_container" stylesheets="@../../../../../style/dashboard.css" text="Aggiorna">
               <graphic>
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../../../../../image/loading-arrow.png" />
                  </ImageView>
               </graphic>
               <HBox.margin>
                  <Insets left="15.0" />
               </HBox.margin>
            </Button>
      </HBox>
  </VBox>

</AnchorPane>
